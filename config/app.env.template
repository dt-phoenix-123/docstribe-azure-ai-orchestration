# Application Environment Variables Template
# IMPORTANT: Never commit actual credentials to the repository!
# 
# Usage:
# 1. Copy this file: cp config/app.env.template config/ai_orchestrator_app.env
# 2. Update with your actual values
# 3. Add to .gitignore to prevent committing secrets
# 
# These are passed to the application containers at runtime

# === API Keys ===
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-endpoint.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=your-deployment
AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment
AZURE_OPENAI_BASE_URL=
OPENAI_API_KEY=your-openai-key
MISTRAL_API_KEY=your-mistral-key          # required (default summarizer)
GROQ_API_KEY=your-groq-key               # optional fallback if SUMMARIZER_PROVIDER=groq
# Summarizer toggle — mistral (default) | groq
SUMMARIZER_PROVIDER=mistral
SUMMARIZER_MODEL=mistral-large-latest
DEEPSEEK_API_KEY=your-deepseek-key

# === MongoDB Configuration ===
DOCSTRIBE_MONGODB_URI=mongodb+srv://username:password@cluster-url/dbname
DOCSTRIBE_DB=your-database-name
LLM_ORCHESTRATOR_DB=your-orchestrator-db
OPD_COLLECTION=opd_workflow

# === Application Configuration ===
DOCSTRIBE_PROJECT_ROOT=/app
DOCSTRIBE_PROMPT_FILE=prompt_config.yaml
DOCSTRIBE_PROJECT_ID=local-docstribe
DOCSTRIBE_TOPIC_ID=pdcm-payload
DOCSTRIBE_OPD_TOPIC_ID=opd-payload
PORT=8080

# === Service Endpoints ===
SIMPLIFICATION_URL=https://your-service.run.app/process_procedure
OPENAI_URL=https://api.openai.com/v1/chat/completions

# === Runtime Configuration ===
DOCSTRIBE_DEBUG=true
AUTOMATION_ENABLED=true
AUTOMATION_BASE_URL=http://ai-orchestrator-app:5000
AUTOMATION_REDIS_URL=redis://redis-ai:6379/0
AUTOMATION_BATCH_THRESHOLD=100

# === Storage Configuration ===
STORAGE_BACKEND=local
STORAGE_PREFIX=
LOCAL_STORAGE_ROOT=/app/data/jsonl
OPD_STORAGE_KEY=continental_opd_jsonl_file.jsonl
PDCM_STORAGE_KEY=ipd_jsonl_batch_file.jsonl

# === Optional Cloud Storage (uncomment as needed) ===
# AWS_REGION_NAME=ap-south-1
# AZURE_STORAGE_CONNECTION_STRING=your-connection-string
# AZURE_STORAGE_ACCOUNT_URL=https://account.blob.core.windows.net
# AZURE_STORAGE_CREDENTIAL=your-credential
# GCP_PROJECT=your-gcp-project